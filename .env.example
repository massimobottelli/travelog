# PostgreSQL
DATABASE_URL=postgresql://travelog:password@localhost:5432/travelog
DATABASE_POOL_MAX=10

# Photo archive mounted from NAS
TRAVELOG_PHOTO_ROOT=/path/to/photo/archive

# HTTP server
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# External tools
EXIFTOOL_PATH=exiftool
