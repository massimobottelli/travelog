# Travelog Environment Configuration — MVP1
# Copy to .env (repository root) and fill in your values for this environment.

# Database connection (required)
DATABASE_URL=postgresql://travelog:travelog@localhost:5432/travelog_dev
DATABASE_POOL_MAX=10

# HTTP server settings (defaults shown — edit to override)
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# External tools
EXIFTOOL_PATH=exiftool

# Geoapify reverse geocoding API key (optional).
# Without a key, geocoding is skipped and photos are saved without
# locality information; scans still complete successfully.
GEOCOAPIFY_API_KEY=

# Functional defaults for the settings stored in the PostgreSQL `settings`
# table. They are applied when the settings row is first created; the
# user's saved values (Settings page) are stored in the database and
# take precedence.
DEFAULT_MIN_CONSECUTIVE_DAYS_WITH_PHOTOS=2
DEFAULT_DAYS_WITHOUT_PHOTOS_THRESHOLD=3

# NOTE: the photo archive root is NOT configured here — it is a functional
# setting stored in the PostgreSQL `settings` table, editable from the
# app Settings page (Impostazioni → Percorso foto).

