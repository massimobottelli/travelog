# Travelog Environment Configuration — MVP1
# Copy to .env (repository root) and fill in your values for this environment.

# Database connection (required)
DATABASE_URL=postgresql://massimo@localhost:5432/travelog_dev
DATABASE_POOL_MAX=10

# Photo archive root directory (mounted from NAS).
# Leave empty: it is configured by the user from the app Settings page
# (Impostazioni → Percorso foto) and persisted in this file.
TRAVELOG_PHOTO_ROOT=

# HTTP server settings
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# External tools
EXIFTOOL_PATH=exiftool

GEOCOAPIFY_API_KEY=